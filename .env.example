# Recovery admin password for username `admin`. Required. Changing this
# takes effect on the next sign-in; existing admin sessions stay valid until
# they expire or are revoked.
DEFAULT_PASSWORD=

# 32+ character secret used to bind session cookies.
SESSION_SECRET=

# 32-byte key as 64 hex characters. Required to encrypt the UniFi API key
# at rest and to restore it from a database backup.
APP_ENCRYPTION_KEY=

# bundled = Compose starts PostgreSQL. external = use DB_HOST below.
DB_MODE=bundled
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=familyfi
DB_USER=familyfi
DB_PASSWORD=

# Optional. Examples: disable, require, verify-full.
# DB_SSL_MODE=require
# DB_SSL_ROOT_CERT=/path/to/ca.pem

# Published host port for `make docker-up` (container still listens on 3000).
APP_PORT=7001

# Optional override for `make docker-up`.
# FAMILYFI_IMAGE=ghcr.io/nberardi/familyfi:latest
