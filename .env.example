# DEFAULT_PASSWORD, SESSION_SECRET, and APP_ENCRYPTION_KEY are generated on
# first setup if omitted. The recovery password is also printed in server logs
# at startup (username admin). Back up APP_ENCRYPTION_KEY with the database.

# bundled = Compose starts PostgreSQL. external = use DB_HOST below.
DB_MODE=bundled
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=familyfi
DB_USER=familyfi
DB_PASSWORD=

# Optional. Examples: disable, require, verify-full.
# DB_SSL_MODE=require
# DB_SSL_ROOT_CERT=/path/to/ca.pem

# Published host port for `make docker-up` (container still listens on 3000).
APP_PORT=7001

# Optional override for `make docker-up`.
# FAMILYFI_IMAGE=ghcr.io/nberardi/familyfi:latest

# Spike CLI only (`make spike SPIKE_ARGS=discover`). Not read by the running app.
# UNIFI_API_KEY=
# UNIFI_BASE_URL=https://192.168.0.1/proxy/network/integration
# UNIFI_CONSOLE_ID=
# UNIFI_SITE_ID=
# UNIFI_SPIKE_MACS=
# UNIFI_SPIKE_INSTALL_ID=local
# UNIFI_TLS_INSECURE=1
# UNIFI_SPIKE_CONFIRM=1
