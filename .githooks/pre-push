#!/bin/sh
# Fast checks before a push, through the same harness as CI: lint, typecheck and unit tests.
# The rest need PostgreSQL; docs/testing.md says which to run for a change.
# Skip once with `git push --no-verify`.
set -e
echo "pre-push: lint, typecheck and unit tests (skip once with git push --no-verify)"
scripts/test.py check lint typecheck
scripts/test.py run --platform host --layer unit
