generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GroupKind {
  family
  things
}

enum FamilyRole {
  child
  teen
  adult
}

enum AssignmentState {
  assigned
  quarantined
}

enum AccountKind {
  recovery
  personal
}

enum SessionKind {
  cookie
  bearer
}

enum PairedDeviceClient {
  phone
  watch
  agent
}

/// What a paired device may call. Each (client, scope) pair is one allowlist in src/server/device-scope.ts:
/// phone:full, watch:rulesOnly, agent:full, agent:readOnly. It bounds the device whatever its account may do.
enum DeviceScope {
  full
  rulesOnly
  readOnly
}

enum ConnectionTransport {
  lan
  tailscale
  cloudflare
}

/// Who runs a route: FamilyFi's quick tunnel, FamilyFi's tunnel on the household's domain, or the household.
enum RouteKind {
  quick
  domain
  own
}

enum ConnectionTrustMode {
  system
  pinned
}

/// What Cloudflare asks of a request before it reaches a route: nothing, or an Access service token.
enum EdgeAuth {
  none
  serviceToken
}

enum PolicyOwnerScope {
  group
  quarantine
}

enum IpVersion {
  ipv4
  ipv6
  dual
}

enum PolicyOperationIntent {
  create
  update
  delete
}

enum ChangeStatus {
  pending
  applied
  partial
  failed
  superseded
}

model Household {
  id                     String    @id @default("default")
  timezone               String    @default("America/New_York")
  unifiMode              String?
  unifiBaseUrl           String?
  unifiConsoleId         String?
  unifiSiteId            String?
  unifiKeyCiphertext     Bytes?
  unifiKeyIv             Bytes?
  unifiKeyAuthTag        Bytes?
  unifiKeyLastFour       String?
  unifiTlsInsecure       Boolean   @default(false)
  unifiManageAllNetworks Boolean   @default(false)
  unifiManagedNetworkIds String[]  @default([])
  quarantineEnforced     Boolean   @default(false)
  dohUrl                 String?
  dohProbeEnabled        Boolean   @default(true)
  dohProbeTime           String    @default("00:00")
  dohProbeDays           Int[]     @default([0])
  dohProbeLastRunAt      DateTime? @db.Timestamptz(3)
  dohProbeTimeoutMs      Int       @default(5000)
  dohProbeDisabledAt     DateTime? @db.Timestamptz(3)
  upstreamResolverSnapshot Json?
  connectionStatus       String    @default("unconfigured")
  connectionError        String?
  displayName            String    @default("FamilyFi household")
  instanceId             String?   @unique
  instancePublicKey      String?
  instancePrivateKeyCiphertext Bytes?
  instancePrivateKeyIv   Bytes?
  instancePrivateKeyAuthTag Bytes?
  /// The one route Remote access publishes to phones; null is Off.
  remoteEndpointId       String?
  revision               Int       @default(0)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)
  connectionEndpoints    ConnectionEndpoint[]
  pairings               Pairing[]
}

model ConnectionEndpoint {
  id           String              @id @default(cuid())
  householdId  String              @default("default")
  household    Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  url          String              @unique
  kind         RouteKind           @default(own)
  transport    ConnectionTransport
  trustMode    ConnectionTrustMode @default(system)
  spkiSha256   String?
  priority     Int                 @default(0)
  enabled      Boolean             @default(true)
  /// A `domain` route's tunnel credential, encrypted with FAMILYFI_ENCRYPTION_KEY. Never served.
  tunnelCredentialCiphertext Bytes?
  tunnelCredentialIv         Bytes?
  tunnelCredentialAuthTag    Bytes?
  edgeAuth                   EdgeAuth @default(none)
  /// An `own` Cloudflare route's Access service token (`{clientId, clientSecret}`), encrypted with
  /// FAMILYFI_ENCRYPTION_KEY. Served only to phones: in the pairing QR and a paired device's manifest.
  edgeTokenCiphertext        Bytes?
  edgeTokenIv                Bytes?
  edgeTokenAuthTag           Bytes?
  /// Starts at 1 and rises each time the token is replaced, so phones and the Pair Device page can tell tokens apart.
  edgeTokenVersion           Int      @default(0)
  edgeTokenRotatedAt         DateTime? @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  pairings     Pairing[]
  edgeTokens   DeviceEdgeToken[]

  @@index([householdId, priority])
}

model PairedDevice {
  id              String         @id @default(cuid())
  displayName     String
  client          PairedDeviceClient @default(phone)
  clientId        String?        @unique
  scope           DeviceScope    @default(full)
  /// The account this device acts as, fixed by the invite it was paired with.
  accountId       String?
  account         Account?       @relation("pairedDeviceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  /// The paired device that vouched for this one: a Watch's phone. Revoking the parent revokes the child.
  parentDeviceId  String?
  parentDevice    PairedDevice?  @relation("pairedDeviceParent", fields: [parentDeviceId], references: [id], onDelete: SetNull)
  children        PairedDevice[] @relation("pairedDeviceParent")
  revokedAt       DateTime? @db.Timestamptz(3)
  lastSeenAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  pairings        Pairing[]      @relation("pairingClaimedDevice")
  parentedPairings Pairing[]     @relation("pairingParentDevice")
  authoredChanges ChangeResult[] @relation("changeActorDevice")
  edgeTokens      DeviceEdgeToken[]
}

/// The last Access token version a device was handed for a route, so rotation can tell who still has the old one.
model DeviceEdgeToken {
  deviceId   String
  device     PairedDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint   ConnectionEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  version    Int
  fetchedAt  DateTime           @default(now()) @db.Timestamptz(3)

  @@id([deviceId, endpointId])
  @@index([endpointId])
}

model Pairing {
  id                 String              @id @default(cuid())
  householdId        String              @default("default")
  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  endpointId         String?
  endpoint           ConnectionEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  tokenHash          String              @unique
  displayName        String
  createdByAccountId String
  expiresAt          DateTime @db.Timestamptz(3)
  claimedAt          DateTime? @db.Timestamptz(3)
  claimedDeviceId    String?             @unique
  claimedDevice      PairedDevice?       @relation("pairingClaimedDevice", fields: [claimedDeviceId], references: [id], onDelete: SetNull)
  /// The account the paired device will act as: an adult chosen by whoever made the invite. Every invite
  /// made since pairing became the sign-in has one; an older one without it can never be claimed.
  accountId          String?
  account            Account?            @relation("pairingAccount", fields: [accountId], references: [id], onDelete: Cascade)
  /// The paired device that made this invite for its companion (`claim=true`).
  parentDeviceId     String?
  parentDevice       PairedDevice?       @relation("pairingParentDevice", fields: [parentDeviceId], references: [id], onDelete: SetNull)
  /// A phone this pairing re-pairs: when the pairing is claimed, that old record is revoked and removed.
  replacesDeviceId   String?
  /// The kind of client this pairing admits. An agent pairing has no route: its code carries the address it was made from.
  client             PairedDeviceClient  @default(phone)
  /// The scope an agent pairing grants; a phone pairing always gives `full`.
  scope              DeviceScope?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

model Group {
  id               String          @id @default(cuid())
  kind             GroupKind
  name             String
  monogram         String?
  familyRole       FamilyRole?
  dohOverrideUrl   String?
  upstreamResolverSnapshot Json?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  devices          Device[]
  accounts         Account[]
  appPolicies      AppPolicy[]
  rules            RuleGroup[]
  systemRule       Rule?           @relation("SystemRule")
  upstreamChecks   UpstreamCheck[]
}

model Account {
  id            String         @id @default(cuid())
  username      String         @unique
  displayName   String
  kind          AccountKind
  passwordHash  String?
  isAdmin       Boolean        @default(true)
  groupId       String?
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  loginAttempts LoginAttempt[]
  authoredChanges ChangeResult[] @relation("changeActorAccount")
  pairedDevices PairedDevice[] @relation("pairedDeviceAccount")
  pairings      Pairing[]      @relation("pairingAccount")
}

model Session {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  kind      SessionKind
  accountId String?
  account   Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  username  String
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  userAgent String?
  deviceId  String?
  device    PairedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// A paired device's bearer is short-lived; this rotating token renews it. Null for cookie sessions.
  refreshTokenHash     String?   @unique
  refreshExpiresAt     DateTime? @db.Timestamptz(3)
  /// The refresh token last replaced, honoured once until `previousRefreshUntil` so a lost response does not sign the device out.
  previousRefreshHash  String?   @unique
  previousRefreshUntil DateTime? @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([username])
  @@index([expiresAt])
  @@index([deviceId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  username  String
  ip        String
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model Device {
  id         String          @id @default(cuid())
  mac        String          @unique
  hostname   String?
  ip         String?
  networkId  String?
  zoneId     String?
  groupId    String?
  group      Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignment AssignmentState @default(quarantined)
  lastSeenAt DateTime? @db.Timestamptz(3)
  presenceOnline Boolean?
  presenceCheckedAt DateTime? @db.Timestamptz(3)
  connectedAt DateTime? @db.Timestamptz(3)
  connectionType String?
  accessPointName String?
  manufacturer String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
}

model AppPolicy {
  id                  String           @id @default(cuid())
  connectionIdentity  String
  siteId              String
  unifiPolicyId       String?          @unique
  ownerScope          PolicyOwnerScope
  groupId             String?
  group               Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  zoneId              String
  ipVersion           IpVersion
  desiredFingerprint  String
  desiredRevision     Int
  observedEnabled     Boolean?
  observedFingerprint String?
  lastError           String?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
}

model PolicyOperation {
  id                 String                @id @default(cuid())
  intent             PolicyOperationIntent
  appPolicyId        String?
  connectionIdentity String
  siteId             String
  payloadFingerprint String?
  unifiPolicyId      String?
  status             String                @default("pending")
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
}

model SyncRun {
  id                String         @id @default(cuid())
  requestedRevision Int
  appliedRevision   Int?
  status            ChangeStatus   @default(pending)
  startedAt         DateTime       @default(now()) @db.Timestamptz(3)
  finishedAt        DateTime? @db.Timestamptz(3)
  error             String?
  changes           ChangeResult[]
}

model ChangeResult {
  id                String       @id @default(cuid())
  syncRunId         String?
  syncRun           SyncRun?     @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  requestedRevision Int
  appliedRevision   Int?
  status            ChangeStatus @default(pending)
  scope             String
  deviceMac         String?
  error             String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  actorAccountId    String?
  actorAccount      Account?     @relation("changeActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorDeviceId     String?
  actorDevice       PairedDevice? @relation("changeActorDevice", fields: [actorDeviceId], references: [id], onDelete: SetNull)

  @@index([actorAccountId, updatedAt])
}

model ReconciliationLock {
  id        String   @id @default("global")
  owner     String
  expiresAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum RuleKind {
  category
  app
  internet
  domain
}

enum RuleMode {
  always
  scheduled
}

/// How a rule came to be lifted: a pause suspends it, an allowance overrides it.
enum RuleLiftKind {
  pause
  allow
}

enum RuleScope {
  group
  network
}

model Rule {
  id               String       @id @default(cuid())
  /// What the household calls it; UniFi policy names follow it.
  name             String
  /// Name the UniFi policies "FamilyFi Rule <id>" instead of after the rule.
  useGeneratedName Boolean      @default(false)
  kind             RuleKind
  scope            RuleScope    @default(group)
  networkIds       String[]     @default([])
  targetIds        Int[]        @default([])
  domains          String[]     @default([])
  enabled          Boolean      @default(true)
  mode             RuleMode     @default(always)
  /// A pause or allowance lifts the rule for every group it covers until `pauseUntil`, or until ended.
  pauseActive      Boolean      @default(false)
  pauseUntil       DateTime? @db.Timestamptz(3)
  pauseKind        RuleLiftKind @default(pause)
  /// Who paused it, as they were named then.
  pausedByAccountId String?
  pausedByName     String?
  /// Set on the one built-in rule a group's own pause uses: an always-on block that is
  /// enabled while the group is paused, until `expiresAt` or until resumed. Hidden from
  /// the rule list; its policies exist only while it is enabled.
  systemGroupId    String?      @unique
  systemGroup      Group?       @relation("SystemRule", fields: [systemGroupId], references: [id], onDelete: Cascade)
  expiresAt        DateTime? @db.Timestamptz(3)
  /// Who started the block, as they were named then.
  blockedByAccountId String?
  blockedByName    String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  groups           RuleGroup[]
  windows          RuleWindow[]
  policies         RulePolicy[]

  @@index([scope])
}

model RuleGroup {
  ruleId  String
  rule    Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// The same lift for this group alone: its devices leave the rule's policies until `pauseUntil`.
  pauseActive       Boolean      @default(false)
  pauseUntil        DateTime? @db.Timestamptz(3)
  pauseKind         RuleLiftKind @default(pause)
  pausedByAccountId String?
  pausedByName      String?

  @@id([ruleId, groupId])
  @@index([groupId])
}

/// One recurring window of a scheduled rule. Each window is its own UniFi policy.
model RuleWindow {
  id       String @id @default(cuid())
  ruleId   String
  rule     Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  position Int
  name     String @default("")
  days     Int[]
  start    String
  end      String

  @@index([ruleId])
}

model RulePolicy {
  id                  String    @id @default(cuid())
  ruleId              String
  rule                Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  /// The RuleWindow id this policy enforces, or "always" for an always-on rule.
  windowKey           String    @default("always")
  connectionIdentity  String
  siteId              String
  unifiPolicyId       String?   @unique
  zoneId              String
  ipVersion           IpVersion @default(dual)
  desiredFingerprint  String
  desiredRevision     Int
  observedEnabled     Boolean?
  observedFingerprint String?
  lastError           String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([ruleId, windowKey, connectionIdentity, siteId, zoneId])
  @@index([connectionIdentity, siteId])
}

enum UpstreamSource {
  seed
  user
}

enum UpstreamVerdict {
  blocked
  partial
  open
  unknown
}

model UpstreamCategory {
  id        String           @id @default(cuid())
  slug      String           @unique
  label     String
  monogram  String
  source    UpstreamSource   @default(user)
  enabled   Boolean          @default(true)
  disabledAt DateTime? @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  domains   UpstreamDomain[]
  checks    UpstreamCheck[]

  @@index([source])
}

model UpstreamDomain {
  id         String           @id @default(cuid())
  categoryId String
  category   UpstreamCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  domain     String
  source     UpstreamSource
  removedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([categoryId, domain])
  @@index([categoryId])
}

model UpstreamCheck {
  id           String           @id @default(cuid())
  categoryId   String
  category     UpstreamCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// The group this verdict was measured for. Null is the household default, which is
  /// what every group without its own endpoint reads.
  groupId      String?
  group        Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  verdict      UpstreamVerdict
  blockedCount Int
  totalCount   Int
  results      Json
  checkedAt    DateTime         @default(now()) @db.Timestamptz(3)
  durationMs   Int
  error        String?
  resolverContext Json?
  networkResults Json?

  @@unique([categoryId, groupId])
  @@index([checkedAt])
  @@index([groupId])
}
