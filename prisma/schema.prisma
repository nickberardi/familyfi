generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GroupKind {
  family
  things
}

enum GroupMode {
  always
  scheduled
}

enum FamilyRole {
  child
  teen
  adult
}

enum AssignmentState {
  assigned
  quarantined
}

enum AccountKind {
  recovery
  personal
}

enum SessionKind {
  cookie
  bearer
}

enum PairedDeviceClient {
  phone
  watch
}

enum ConnectionTransport {
  lan
  tailscale
  cloudflare
}

/// Who runs a route: FamilyFi's quick tunnel, FamilyFi's tunnel on the household's domain, or the household.
enum RouteKind {
  quick
  domain
  own
}

enum ConnectionTrustMode {
  system
  pinned
}

/// What Cloudflare asks of a request before it reaches a route: nothing, or an Access service token.
enum EdgeAuth {
  none
  serviceToken
}

enum PolicyOwnerScope {
  group
  quarantine
}

enum IpVersion {
  ipv4
  ipv6
  dual
}

enum PolicyOperationIntent {
  create
  update
  delete
}

enum ChangeStatus {
  pending
  applied
  partial
  failed
  superseded
}

model Household {
  id                     String    @id @default("default")
  timezone               String    @default("America/New_York")
  unifiMode              String?
  unifiBaseUrl           String?
  unifiConsoleId         String?
  unifiSiteId            String?
  unifiKeyCiphertext     Bytes?
  unifiKeyIv             Bytes?
  unifiKeyAuthTag        Bytes?
  unifiKeyLastFour       String?
  unifiTlsInsecure       Boolean   @default(false)
  unifiManageAllNetworks Boolean   @default(false)
  unifiManagedNetworkIds String[]  @default([])
  quarantineEnforced     Boolean   @default(true)
  dohUrl                 String?
  dohProbeEnabled        Boolean   @default(false)
  dohProbeTime           String    @default("12:00")
  dohProbeDays           Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  dohProbeLastRunAt      DateTime?
  dohProbeTimeoutMs      Int       @default(5000)
  connectionStatus       String    @default("unconfigured")
  connectionError        String?
  displayName            String    @default("FamilyFi household")
  instanceId             String?   @unique
  instancePublicKey      String?
  instancePrivateKeyCiphertext Bytes?
  instancePrivateKeyIv   Bytes?
  instancePrivateKeyAuthTag Bytes?
  /// The one route Remote access publishes to phones; null is Off.
  remoteEndpointId       String?
  revision               Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  connectionEndpoints    ConnectionEndpoint[]
  pairings               Pairing[]
}

model ConnectionEndpoint {
  id           String              @id @default(cuid())
  householdId  String              @default("default")
  household    Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  url          String              @unique
  kind         RouteKind           @default(own)
  transport    ConnectionTransport
  trustMode    ConnectionTrustMode @default(system)
  spkiSha256   String?
  priority     Int                 @default(0)
  enabled      Boolean             @default(true)
  /// A `domain` route's tunnel credential, encrypted with FAMILYFI_ENCRYPTION_KEY. Never served.
  tunnelCredentialCiphertext Bytes?
  tunnelCredentialIv         Bytes?
  tunnelCredentialAuthTag    Bytes?
  edgeAuth                   EdgeAuth @default(none)
  /// An `own` Cloudflare route's Access service token (`{clientId, clientSecret}`), encrypted with
  /// FAMILYFI_ENCRYPTION_KEY. Served only to phones: in the pairing QR and a paired device's manifest.
  edgeTokenCiphertext        Bytes?
  edgeTokenIv                Bytes?
  edgeTokenAuthTag           Bytes?
  /// Starts at 1 and rises each time the token is replaced, so phones and the Pair Device page can tell tokens apart.
  edgeTokenVersion           Int      @default(0)
  edgeTokenRotatedAt         DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  pairings     Pairing[]
  edgeTokens   DeviceEdgeToken[]

  @@index([householdId, priority])
}

model PairedDevice {
  id              String         @id @default(cuid())
  displayName     String
  credentialHash  String         @unique
  client          PairedDeviceClient @default(phone)
  clientId        String?        @unique
  revokedAt       DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        Session[]
  pairings        Pairing[]
  authoredChanges ChangeResult[] @relation("changeActorDevice")
  edgeTokens      DeviceEdgeToken[]
}

/// The last Access token version a device was handed for a route, so rotation can tell who still has the old one.
model DeviceEdgeToken {
  deviceId   String
  device     PairedDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint   ConnectionEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  version    Int
  fetchedAt  DateTime           @default(now())

  @@id([deviceId, endpointId])
  @@index([endpointId])
}

model Pairing {
  id                 String              @id @default(cuid())
  householdId        String              @default("default")
  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  endpointId         String?
  endpoint           ConnectionEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  tokenHash          String              @unique
  displayName        String
  createdByAccountId String
  expiresAt          DateTime
  claimedAt          DateTime?
  claimedDeviceId    String?             @unique
  claimedDevice      PairedDevice?       @relation(fields: [claimedDeviceId], references: [id], onDelete: SetNull)
  /// A phone this pairing re-pairs: when the pairing is claimed, that old record is revoked and removed.
  replacesDeviceId   String?
  createdAt          DateTime            @default(now())

  @@index([expiresAt])
}

model Group {
  id               String          @id @default(cuid())
  kind             GroupKind
  name             String
  monogram         String?
  familyRole       FamilyRole?
  protected        Boolean         @default(false)
  mode             GroupMode       @default(always)
  scheduleEnabled  Boolean         @default(false)
  scheduleDays     Int[]           @default([])
  scheduleStart    String?
  scheduleEnd      String?
  suspensionActive Boolean         @default(false)
  suspensionUntil  DateTime?
  dohOverrideUrl   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  devices          Device[]
  accounts         Account[]
  appPolicies      AppPolicy[]
  rules            Rule[]
  upstreamChecks   UpstreamCheck[]
}

model Account {
  id            String         @id @default(cuid())
  username      String         @unique
  displayName   String
  kind          AccountKind
  passwordHash  String?
  isAdmin       Boolean        @default(true)
  groupId       String?
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  loginAttempts LoginAttempt[]
  authoredChanges ChangeResult[] @relation("changeActorAccount")
}

model Session {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  kind      SessionKind
  accountId String?
  account   Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  username  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  deviceId  String?
  device    PairedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([username])
  @@index([expiresAt])
  @@index([deviceId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  username  String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model Device {
  id         String          @id @default(cuid())
  mac        String          @unique
  hostname   String?
  ip         String?
  networkId  String?
  zoneId     String?
  groupId    String?
  group      Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignment AssignmentState @default(quarantined)
  lastSeenAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model AppPolicy {
  id                  String           @id @default(cuid())
  connectionIdentity  String
  siteId              String
  unifiPolicyId       String?          @unique
  ownerScope          PolicyOwnerScope
  groupId             String?
  group               Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  zoneId              String
  ipVersion           IpVersion
  desiredFingerprint  String
  desiredRevision     Int
  observedEnabled     Boolean?
  observedFingerprint String?
  lastError           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model PolicyOperation {
  id                 String                @id @default(cuid())
  intent             PolicyOperationIntent
  appPolicyId        String?
  connectionIdentity String
  siteId             String
  payloadFingerprint String?
  unifiPolicyId      String?
  status             String                @default("pending")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model SyncRun {
  id                String         @id @default(cuid())
  requestedRevision Int
  appliedRevision   Int?
  status            ChangeStatus   @default(pending)
  startedAt         DateTime       @default(now())
  finishedAt        DateTime?
  error             String?
  changes           ChangeResult[]
}

model ChangeResult {
  id                String       @id @default(cuid())
  syncRunId         String?
  syncRun           SyncRun?     @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  requestedRevision Int
  appliedRevision   Int?
  status            ChangeStatus @default(pending)
  scope             String
  deviceMac         String?
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  actorAccountId    String?
  actorAccount      Account?     @relation("changeActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorDeviceId     String?
  actorDevice       PairedDevice? @relation("changeActorDevice", fields: [actorDeviceId], references: [id], onDelete: SetNull)

  @@index([actorAccountId, updatedAt])
}

model ReconciliationLock {
  id        String   @id @default("global")
  owner     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

enum RuleKind {
  category
  app
}

enum RuleMode {
  always
  scheduled
}

enum RuleScope {
  group
  network
}

model Rule {
  id              String       @id @default(cuid())
  kind            RuleKind
  scope           RuleScope    @default(group)
  groupId         String?
  group           Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  networkIds      String[]     @default([])
  targetIds       Int[]
  enabled         Boolean      @default(true)
  mode            RuleMode     @default(always)
  scheduleEnabled Boolean      @default(false)
  scheduleDays    Int[]        @default([])
  scheduleStart   String?
  scheduleEnd     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  policies        RulePolicy[]

  @@index([groupId])
  @@index([scope])
}

model RulePolicy {
  id                  String    @id @default(cuid())
  ruleId              String
  rule                Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  connectionIdentity  String
  siteId              String
  unifiPolicyId       String?   @unique
  zoneId              String
  ipVersion           IpVersion @default(dual)
  desiredFingerprint  String
  desiredRevision     Int
  observedEnabled     Boolean?
  observedFingerprint String?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([ruleId, connectionIdentity, siteId, zoneId])
  @@index([connectionIdentity, siteId])
}

enum UpstreamSource {
  seed
  user
}

enum UpstreamVerdict {
  blocked
  partial
  open
  unknown
}

model UpstreamCategory {
  id        String           @id @default(cuid())
  slug      String           @unique
  label     String
  monogram  String
  source    UpstreamSource   @default(user)
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  domains   UpstreamDomain[]
  checks    UpstreamCheck[]

  @@index([source])
}

model UpstreamDomain {
  id         String           @id @default(cuid())
  categoryId String
  category   UpstreamCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  domain     String
  source     UpstreamSource
  removedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([categoryId, domain])
  @@index([categoryId])
}

model UpstreamCheck {
  id           String           @id @default(cuid())
  categoryId   String
  category     UpstreamCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// The group this verdict was measured for. Null is the household default, which is
  /// what every group without its own endpoint reads.
  groupId      String?
  group        Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  verdict      UpstreamVerdict
  blockedCount Int
  totalCount   Int
  results      Json
  checkedAt    DateTime         @default(now())
  durationMs   Int
  error        String?

  @@unique([categoryId, groupId])
  @@index([checkedAt])
  @@index([groupId])
}
