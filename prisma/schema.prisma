generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GroupKind {
  family
  things
}

enum FamilyRole {
  child
  teen
  adult
}

enum AssignmentState {
  assigned
  quarantined
}

enum AccountKind {
  recovery
  personal
}

enum SessionKind {
  cookie
  bearer
}

/// What FamilyFi's own check of a route found: its identity answered as this household, or not.
enum RouteCheckResult {
  reached
  failed
}

enum ConnectionTransport {
  lan
  tailscale
  cloudflare
}

/// Who runs a route: FamilyFi's quick tunnel, FamilyFi's tunnel on the household's domain, or the household.
enum RouteKind {
  quick
  domain
  own
}

enum ConnectionTrustMode {
  system
  pinned
}

/// What Cloudflare asks of a request before it reaches a route: nothing, or an Access service token.
enum EdgeAuth {
  none
  serviceToken
}

enum PolicyOwnerScope {
  group
  quarantine
}

enum IpVersion {
  ipv4
  ipv6
  dual
}

enum PolicyOperationIntent {
  create
  update
  delete
}

/// requested until the outcome is known: the new release is running (succeeded), Watchtower did not
/// replace it (failed; a failed pre-update backup counts here), skipped it, or found nothing newer.
enum UpdateStatus {
  requested
  succeeded
  failed
  skipped
  unchanged
}

enum ChangeStatus {
  pending
  applied
  partial
  failed
  superseded
}

model Household {
  id                     String    @id @default("default")
  timezone               String    @default("America/New_York")
  unifiMode              String?
  unifiBaseUrl           String?
  unifiConsoleId         String?
  unifiSiteId            String?
  unifiKeyCiphertext     Bytes?
  unifiKeyIv             Bytes?
  unifiKeyAuthTag        Bytes?
  unifiKeyLastFour       String?
  unifiTlsInsecure       Boolean   @default(false)
  unifiManageAllNetworks Boolean   @default(false)
  unifiManagedNetworkIds String[]  @default([])
  quarantineEnforced     Boolean   @default(false)
  dohUrl                 String?
  dohProbeEnabled        Boolean   @default(true)
  dohProbeTime           String    @default("00:00")
  dohProbeDays           Int[]     @default([0])
  dohProbeLastRunAt      DateTime? @db.Timestamptz(3)
  dohProbeTimeoutMs      Int       @default(5000)
  dohProbeDisabledAt     DateTime? @db.Timestamptz(3)
  /// Installing a newer release through the Watchtower sidecar (src/server/updater.ts). The schedule
  /// is household-local cron, `minute hour * * days` (src/server/weekly-schedule.ts); the last claimed
  /// instant keeps two processes from both installing.
  updateScheduleEnabled   Boolean       @default(true)
  updateSchedule          String        @default("0 0 * * 0")
  updateScheduleLastRunAt DateTime?     @db.Timestamptz(3)
  /// The latest install: written before Watchtower is asked, because the process that asks is the
  /// one being replaced, and settled by the next process to read it. Null until the first install.
  updateRequestedAt       DateTime?     @db.Timestamptz(3)
  updateTargetVersion     String?
  updateStatus            UpdateStatus?
  updateError             String?
  upstreamResolverSnapshot Json?
  /// The last network checkup (src/server/checkup.ts): when it finished, and why it could not read
  /// the gateway, when it could not. Its findings are `CheckupFinding` rows.
  checkupRanAt           DateTime? @db.Timestamptz(3)
  checkupError           String?
  /// Checks the last run could not make (a read failed), so they are neither passed nor found.
  checkupSkipped         String[]  @default([])
  /// When the last sync pass checked every device's presence. A device offline since an earlier
  /// pass is not written again, so this, not its own `presenceCheckedAt`, says it is still current.
  presenceCheckedAt      DateTime? @db.Timestamptz(3)
  connectionStatus       String    @default("unconfigured")
  connectionError        String?
  displayName            String    @default("FamilyFi household")
  instanceId             String?   @unique
  instancePublicKey      String?
  instancePrivateKeyCiphertext Bytes?
  instancePrivateKeyIv   Bytes?
  instancePrivateKeyAuthTag Bytes?
  /// The one route Remote access publishes to phones; null is Off.
  remoteEndpointId       String?
  /// Where FamilyFi is on the home network (an http or https origin), apart from the route Remote
  /// access publishes. Agents pair here; null pairs them at the address the code was made at.
  homeUrl                String?
  /// Phone alerts through the project relay (src/server/alerts): off until an administrator turns
  /// them on. The install id and secret are this server's credential at the relay, issued on the
  /// first send; the secret is encrypted with FAMILYFI_ENCRYPTION_KEY and never served or exported.
  alertsRelayEnabled     Boolean   @default(false)
  alertsInstallId        String?
  alertsInstallSecretCiphertext Bytes?
  alertsInstallSecretIv  Bytes?
  alertsInstallSecretAuthTag Bytes?
  /// The first sync pass that failed since the last one that reached the gateway, and when phones
  /// were told sync is in trouble; both clear on the next pass that reaches it.
  syncFailingSince       DateTime? @db.Timestamptz(3)
  syncTroubleAlertedAt   DateTime? @db.Timestamptz(3)
  /// Asking for more time (FamilyFi Me): how long an ask waits for an answer before it times out,
  /// and how long after a parent's Not now the child can ask again. Minutes.
  askTimeoutMinutes      Int       @default(60)
  askWaitMinutes         Int       @default(30)
  revision               Int       @default(0)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)
  connectionEndpoints    ConnectionEndpoint[]
  pairings               Pairing[]
}

model ConnectionEndpoint {
  id           String              @id @default(cuid())
  householdId  String              @default("default")
  household    Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  url          String              @unique
  kind         RouteKind           @default(own)
  transport    ConnectionTransport
  trustMode    ConnectionTrustMode @default(system)
  spkiSha256   String?
  priority     Int                 @default(0)
  enabled      Boolean             @default(true)
  /// A `domain` route's tunnel credential, encrypted with FAMILYFI_ENCRYPTION_KEY. Never served.
  tunnelCredentialCiphertext Bytes?
  tunnelCredentialIv         Bytes?
  tunnelCredentialAuthTag    Bytes?
  edgeAuth                   EdgeAuth @default(none)
  /// An `own` Cloudflare route's Access service token (`{clientId, clientSecret}`), encrypted with
  /// FAMILYFI_ENCRYPTION_KEY. Served only to phones: in the pairing QR and a paired device's manifest.
  edgeTokenCiphertext        Bytes?
  edgeTokenIv                Bytes?
  edgeTokenAuthTag           Bytes?
  /// Starts at 1 and rises each time the token is replaced, so phones and the Pair Device page can tell tokens apart.
  edgeTokenVersion           Int      @default(0)
  edgeTokenRotatedAt         DateTime? @db.Timestamptz(3)
  /// Evidence the route works, since it was last published or changed: the last request that
  /// came in through it, and FamilyFi's own last check of it from home.
  reachedAt                  DateTime? @db.Timestamptz(3)
  checkedAt                  DateTime? @db.Timestamptz(3)
  checkResult                RouteCheckResult?
  checkMessage               String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  pairings     Pairing[]
  edgeTokens   DeviceEdgeToken[]

  @@index([householdId, priority])
}

model PairedDevice {
  id              String         @id @default(cuid())
  displayName     String
  /// Which client this is: app, app-watch, app-controls, me or agent (src/lib/client-type.ts).
  clientType      String         @default("app")
  clientId        String?        @unique
  /// What it may call, as one value: app:full, app:rulesOnly, agent:full, agent:readOnly or me:askOnly.
  /// Each is one allowlist in src/server/device-scope.ts; CLIENT_SCOPES says which client type holds which.
  scope           String         @default("app:full")
  /// The account this device acts as, fixed by the invite it was paired with.
  accountId       String?
  account         Account?       @relation("pairedDeviceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  /// A child's phone (FamilyFi Me, `me`) signs in for its family group, never as an account: it has a
  /// group and no account. Deleting the group revokes the device in code first (src/server/groups.ts),
  /// so the record and its history stay; the link then clears.
  groupId         String?
  group           Group?         @relation("pairedDeviceGroup", fields: [groupId], references: [id], onDelete: SetNull)
  /// The paired device that vouched for this one: a Watch's phone. Revoking the parent revokes the child.
  parentDeviceId  String?
  parentDevice    PairedDevice?  @relation("pairedDeviceParent", fields: [parentDeviceId], references: [id], onDelete: SetNull)
  children        PairedDevice[] @relation("pairedDeviceParent")
  revokedAt       DateTime? @db.Timestamptz(3)
  lastSeenAt      DateTime? @db.Timestamptz(3)
  /// A child's phone (FamilyFi Me) only: what it last said of its Screen Time permission, `on`,
  /// `notAllowed` or `removed` (src/lib/me-protection.ts), and when. Null until it says.
  protection      String?
  protectionAt    DateTime? @db.Timestamptz(3)
  /// When parents were told this child's phone had gone quiet; cleared when it is heard from again.
  quietAlertedAt  DateTime? @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  pairings        Pairing[]      @relation("pairingClaimedDevice")
  parentedPairings Pairing[]     @relation("pairingParentDevice")
  authoredChanges ChangeResult[] @relation("changeActorDevice")
  edgeTokens      DeviceEdgeToken[]
  pushRegistration PushRegistration?
  alertEvents     AlertEvent[]
  asks            Ask[]
}

/// The last Access token version a device was handed for a route, so rotation can tell who still has the old one.
model DeviceEdgeToken {
  deviceId   String
  device     PairedDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint   ConnectionEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  version    Int
  fetchedAt  DateTime           @default(now()) @db.Timestamptz(3)

  @@id([deviceId, endpointId])
  @@index([endpointId])
}

enum PushPlatform {
  ios
  android
}

/// Which build of the app registered: `release` (App Store, TestFlight, Play) or `development`,
/// which picks the APNs topic and environment at the relay.
enum PushChannel {
  release
  development
}

/// A paired app's push token and alert key, which only that app sets (src/server/alerts/registrations.ts).
/// The token and the 32-byte key are encrypted with FAMILYFI_ENCRYPTION_KEY and never served. Kinds
/// are strings checked against src/lib/alert-kinds.ts, so a new kind needs no migration.
model PushRegistration {
  deviceId          String       @id
  device            PairedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  platform          PushPlatform
  channel           PushChannel
  tokenCiphertext   Bytes
  tokenIv           Bytes
  tokenAuthTag      Bytes
  keyCiphertext     Bytes
  keyIv             Bytes
  keyAuthTag        Bytes
  /// The highest alert envelope version the app reads.
  format            Int
  supportedKinds    String[]
  mutedKinds        String[]     @default([])
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
}

/// The alert outbox: one row per event and phone, written by the code that saw the change and
/// sent by src/server/alerts/sender.ts. `dedupeKey` is the event's id, shared by its phones.
model AlertEvent {
  id            String       @id @default(cuid())
  kind          String
  deviceId      String
  device        PairedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  detail        Json
  dedupeKey     String
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  sentAt        DateTime?    @db.Timestamptz(3)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([deviceId, dedupeKey])
  @@index([sentAt, nextAttemptAt])
}

model Pairing {
  id                 String              @id @default(cuid())
  householdId        String              @default("default")
  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  endpointId         String?
  endpoint           ConnectionEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  tokenHash          String              @unique
  displayName        String
  createdByAccountId String
  expiresAt          DateTime @db.Timestamptz(3)
  claimedAt          DateTime? @db.Timestamptz(3)
  claimedDeviceId    String?             @unique
  claimedDevice      PairedDevice?       @relation("pairingClaimedDevice", fields: [claimedDeviceId], references: [id], onDelete: SetNull)
  /// The account the paired device will act as: an adult chosen by whoever made the invite. Every invite
  /// made since pairing became the sign-in has one; an older one without it can never be claimed.
  accountId          String?
  account            Account?            @relation("pairingAccount", fields: [accountId], references: [id], onDelete: Cascade)
  /// The family group a child's phone (`me`) will sign in for, instead of an account.
  groupId            String?
  group              Group?              @relation("pairingGroup", fields: [groupId], references: [id], onDelete: SetNull)
  /// The paired device that made this invite for its companion (`claim=true`).
  parentDeviceId     String?
  parentDevice       PairedDevice?       @relation("pairingParentDevice", fields: [parentDeviceId], references: [id], onDelete: SetNull)
  /// The paired phone that made a child's phone's invite (`me`), which is not its parent: revoking the
  /// phone cancels the invite while it waits, and leaves the child's phone it paired alone.
  madeByDeviceId     String?
  /// A phone this pairing re-pairs: when the pairing is claimed, that old record is revoked and removed.
  replacesDeviceId   String?
  /// The client type this pairing admits (src/lib/client-type.ts). An agent pairing has no route: its code carries the address it was made from.
  clientType         String              @default("app")
  /// The scope the device gets, such as `app:full` or `agent:readOnly`. A pairing without one is never claimed.
  scope              String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

model Group {
  id               String          @id @default(cuid())
  kind             GroupKind
  name             String
  monogram         String?
  familyRole       FamilyRole?
  dohOverrideUrl   String?
  upstreamResolverSnapshot Json?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  devices          Device[]
  accounts         Account[]
  appPolicies      AppPolicy[]
  rules            RuleGroup[]
  systemRule       Rule?           @relation("SystemRule")
  /// The group's Block button default, which the card's Unblock lifts and Block puts back: one of its
  /// own category, app or website rules. Null: all internet. No foreign key, since a group's own
  /// block rule already points the other way; deleting the rule clears it, and a rule that no
  /// longer covers the group reads as all internet.
  blockButtonRuleId String?
  upstreamChecks   UpstreamCheck[]
  /// FamilyFi Me on the child's phones (`me` paired devices), and their invites.
  pairedDevices    PairedDevice[]  @relation("pairedDeviceGroup")
  pairings         Pairing[]       @relation("pairingGroup")
  asks             Ask[]
}

model Account {
  id            String         @id @default(cuid())
  username      String         @unique
  displayName   String
  kind          AccountKind
  passwordHash  String?
  isAdmin       Boolean        @default(true)
  groupId       String?
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  loginAttempts LoginAttempt[]
  authoredChanges ChangeResult[] @relation("changeActorAccount")
  pairedDevices PairedDevice[] @relation("pairedDeviceAccount")
  pairings      Pairing[]      @relation("pairingAccount")
}

model Session {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  kind      SessionKind
  accountId String?
  account   Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  username  String
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  userAgent String?
  deviceId  String?
  device    PairedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// A paired device's bearer is short-lived; this rotating token renews it. Null for cookie sessions.
  refreshTokenHash     String?   @unique
  refreshExpiresAt     DateTime? @db.Timestamptz(3)
  /// The refresh token last replaced, honoured until `previousRefreshUntil` so a lost response does not sign the device out:
  /// the end of the refresh window until the device uses the new pair, then a few seconds.
  previousRefreshHash  String?   @unique
  previousRefreshUntil DateTime? @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([username])
  @@index([expiresAt])
  @@index([deviceId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  username  String
  ip        String
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model Device {
  id         String          @id @default(cuid())
  mac        String          @unique
  hostname   String?
  ip         String?
  networkId  String?
  zoneId     String?
  groupId    String?
  group      Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignment AssignmentState @default(quarantined)
  lastSeenAt DateTime? @db.Timestamptz(3)
  presenceOnline Boolean?
  presenceCheckedAt DateTime? @db.Timestamptz(3)
  connectedAt DateTime? @db.Timestamptz(3)
  connectionType String?
  accessPointName String?
  manufacturer String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
}

/// Something the network checkup saw that the household may want to change. FamilyFi only reads and
/// explains; it never changes the gateway because of one. `key` is the check and what it is about,
/// so a run updates the same row; `subject` fingerprints what was seen, and a dismissal holds only
/// while the subject is the one dismissed.
model CheckupFinding {
  key              String   @id
  check            String
  details          Json
  subject          String
  firstSeenAt      DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt       DateTime @default(now()) @db.Timestamptz(3)
  dismissedAt      DateTime? @db.Timestamptz(3)
  dismissedSubject String?
}

model AppPolicy {
  id                  String           @id @default(cuid())
  connectionIdentity  String
  siteId              String
  unifiPolicyId       String?          @unique
  ownerScope          PolicyOwnerScope
  groupId             String?
  group               Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  zoneId              String
  ipVersion           IpVersion
  desiredFingerprint  String
  desiredRevision     Int
  observedEnabled     Boolean?
  observedFingerprint String?
  lastError           String?
  /// What someone last changed on this policy in the UniFi console, which sync put back
  /// (`GatewayDriftChange[]`); cleared when FamilyFi's own version changes.
  gatewayDrift        Json?
  driftSeenAt         DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
}

model PolicyOperation {
  id                 String                @id @default(cuid())
  intent             PolicyOperationIntent
  appPolicyId        String?
  connectionIdentity String
  siteId             String
  payloadFingerprint String?
  /// The write a create sent, matched against the gateway's policies when its answer was lost.
  payload            Json?
  unifiPolicyId      String?
  status             String                @default("pending")
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  @@index([unifiPolicyId])
  @@index([connectionIdentity, siteId, intent, status])
  @@index([status, updatedAt])
}

model SyncRun {
  id                String         @id @default(cuid())
  requestedRevision Int
  appliedRevision   Int?
  status            ChangeStatus   @default(pending)
  startedAt         DateTime       @default(now()) @db.Timestamptz(3)
  finishedAt        DateTime? @db.Timestamptz(3)
  error             String?
  changes           ChangeResult[]

  @@index([startedAt])
}

model ChangeResult {
  id                String       @id @default(cuid())
  syncRunId         String?
  syncRun           SyncRun?     @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  requestedRevision Int
  appliedRevision   Int?
  status            ChangeStatus @default(pending)
  scope             String
  deviceMac         String?
  error             String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  actorAccountId    String?
  actorAccount      Account?     @relation("changeActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorDeviceId     String?
  actorDevice       PairedDevice? @relation("changeActorDevice", fields: [actorDeviceId], references: [id], onDelete: SetNull)

  @@index([actorAccountId, updatedAt])
  @@index([updatedAt])
  @@index([status])
  @@index([syncRunId])
}

model ReconciliationLock {
  id        String   @id @default("global")
  owner     String
  expiresAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum RuleKind {
  category
  app
  internet
  domain
}

enum RuleMode {
  always
  scheduled
}

/// How a rule came to be lifted: a pause suspends it, an allowance overrides it.
enum RuleLiftKind {
  pause
  allow
}

enum RuleScope {
  group
  network
}

model Rule {
  id               String       @id @default(cuid())
  /// What the household calls it; UniFi policy names follow it.
  name             String
  /// Name the UniFi policies "FamilyFi Rule <id>" instead of after the rule.
  useGeneratedName Boolean      @default(false)
  kind             RuleKind
  scope            RuleScope    @default(group)
  networkIds       String[]     @default([])
  targetIds        Int[]        @default([])
  domains          String[]     @default([])
  /// The built-in `countries` rule's ISO 3166-1 alpha-2 codes; empty on every other rule.
  countries        String[]     @default([])
  /// The built-in `dns` rule also turns off iCloud Private Relay (experimental); false on every other rule.
  blockPrivateRelay Boolean     @default(false)
  /// The DNS the built-in `dns` rule left open at its last sync (`LockDnsOpen[]`); empty on every other rule.
  openDns          Json         @default("[]")
  enabled          Boolean      @default(true)
  mode             RuleMode     @default(always)
  /// A pause or allowance lifts the rule for every group it covers until `pauseUntil`, or until ended.
  pauseActive      Boolean      @default(false)
  pauseUntil       DateTime? @db.Timestamptz(3)
  pauseKind        RuleLiftKind @default(pause)
  /// Who paused it, as they were named then.
  pausedByAccountId String?
  pausedByName     String?
  /// Set on the one built-in rule a group's own pause uses: an always-on block that is
  /// enabled while the group is paused, until `expiresAt` or until resumed. Hidden from
  /// the rule list; its policies exist only while it is enabled.
  systemGroupId    String?      @unique
  systemGroup      Group?       @relation("SystemRule", fields: [systemGroupId], references: [id], onDelete: Cascade)
  expiresAt        DateTime? @db.Timestamptz(3)
  /// Who started the block, as they were named then.
  blockedByAccountId String?
  blockedByName    String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  groups           RuleGroup[]
  windows          RuleWindow[]
  policies         RulePolicy[]

  @@index([scope])
}

model RuleGroup {
  ruleId  String
  rule    Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// The same lift for this group alone: its devices leave the rule's policies until `pauseUntil`.
  pauseActive       Boolean      @default(false)
  pauseUntil        DateTime? @db.Timestamptz(3)
  pauseKind         RuleLiftKind @default(pause)
  pausedByAccountId String?
  pausedByName      String?

  @@id([ruleId, groupId])
  @@index([groupId])
}

/// One recurring window of a scheduled rule. Each window is its own UniFi policy.
model RuleWindow {
  id       String @id @default(cuid())
  ruleId   String
  rule     Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  position Int
  name     String @default("")
  days     Int[]
  start    String
  end      String

  @@index([ruleId])
}

model RulePolicy {
  id                  String    @id @default(cuid())
  ruleId              String
  rule                Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  /// The RuleWindow id this policy enforces, or "always" for an always-on rule.
  windowKey           String    @default("always")
  connectionIdentity  String
  siteId              String
  unifiPolicyId       String?   @unique
  zoneId              String
  ipVersion           IpVersion @default(dual)
  desiredFingerprint  String
  desiredRevision     Int
  observedEnabled     Boolean?
  observedFingerprint String?
  lastError           String?
  /// What someone last changed on this policy in the UniFi console, which sync put back
  /// (`GatewayDriftChange[]`); cleared when FamilyFi's own version changes.
  gatewayDrift        Json?
  driftSeenAt         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([ruleId, windowKey, connectionIdentity, siteId, zoneId])
  @@index([connectionIdentity, siteId])
}

enum UpstreamSource {
  seed
  user
}

enum UpstreamVerdict {
  blocked
  partial
  open
  unknown
}

model UpstreamCategory {
  id        String           @id @default(cuid())
  slug      String           @unique
  label     String
  monogram  String
  source    UpstreamSource   @default(user)
  enabled   Boolean          @default(true)
  disabledAt DateTime? @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  domains   UpstreamDomain[]
  checks    UpstreamCheck[]

  @@index([source])
}

model UpstreamDomain {
  id         String           @id @default(cuid())
  categoryId String
  category   UpstreamCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  domain     String
  source     UpstreamSource
  removedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([categoryId, domain])
  @@index([categoryId])
}

model UpstreamCheck {
  id           String           @id @default(cuid())
  categoryId   String
  category     UpstreamCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// The group this verdict was measured for. Null is the household default, which is
  /// what every group without its own endpoint reads.
  groupId      String?
  group        Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  verdict      UpstreamVerdict
  blockedCount Int
  totalCount   Int
  results      Json
  checkedAt    DateTime         @default(now()) @db.Timestamptz(3)
  durationMs   Int
  error        String?
  resolverContext Json?
  networkResults Json?

  @@unique([categoryId, groupId])
  @@index([checkedAt])
  @@index([groupId])
}

enum AskState {
  waiting
  yes
  no
  timedOut
  ended
}

/// A child's ask for more time (FamilyFi Me), filed by its phone on its own group: to end the group's
/// pause (`about` pause) or to lift one rule's window for it (`about` rule). At most one waits per
/// group. A parent answers yes with the group's resume or the rule's allow, or no with decline; an
/// ask left waiting closes at `expiresAt`: `ended` when that is the block's end, else `timedOut`.
model Ask {
  id                  String        @id @default(cuid())
  groupId             String
  group               Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  deviceId            String?
  device              PairedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  about               String
  /// The rule asked about, for `about` rule. No foreign key: a deleted rule leaves the ask as it was.
  ruleId              String?
  minutes             Int?
  state               AskState      @default(waiting)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt           DateTime      @db.Timestamptz(3)
  /// Whether `expiresAt` is the end of the block asked about rather than the household's timeout.
  endsWithBlock       Boolean       @default(false)
  answeredAt          DateTime?     @db.Timestamptz(3)
  answeredByAccountId String?
  answeredByName      String?
  /// After a no: when the child may ask again.
  askAgainAt          DateTime?     @db.Timestamptz(3)

  @@index([groupId, createdAt])
  @@index([state, expiresAt])
}
