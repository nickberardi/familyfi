{
  "name": "familyfi",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/with-env.mjs next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "node scripts/with-env.mjs next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "playwright test",
    "test-api": "node scripts/check-openapi.mjs",
    "spike": "node scripts/with-env.mjs tsx scripts/spike/index.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swagger-ui-react": "^5.32.15",
    "undici": "^8.10.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^1.34.20",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "@faker-js/faker": "^10.5.0",
    "js-yaml": "4.3.2",
    "@vitest/mocker": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2",
      "@faker-js/faker": "^10.5.0",
      "js-yaml": "4.3.2",
      "@vitest/mocker": "^4.1.11"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "core-js",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
